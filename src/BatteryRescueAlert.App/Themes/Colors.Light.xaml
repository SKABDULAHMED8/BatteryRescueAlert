<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light palette. Text/background pairs are chosen for WCAG AA (4.5:1) or better. -->
    <SolidColorBrush x:Key="BgBrush" Color="#F3F5F7" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="#EAEFF2" />
    <SolidColorBrush x:Key="LineBrush" Color="#CBD3DA" />
    <SolidColorBrush x:Key="TextBrush" Color="#14202B" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#4A5866" />
    <SolidColorBrush x:Key="AccentBrush" Color="#0F6E6A" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#0B5A57" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#084442" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="GoodBrush" Color="#1B7F3B" />
    <SolidColorBrush x:Key="WarnBrush" Color="#9A5B00" />
    <SolidColorBrush x:Key="DangerBrush" Color="#B3261E" />
    <SolidColorBrush x:Key="TrackBrush" Color="#D8DFE5" />
    <SolidColorBrush x:Key="FocusBrush" Color="#0F5FCC" />
    <SolidColorBrush x:Key="NoticeBgBrush" Color="#FFF4DB" />
    <SolidColorBrush x:Key="NoticeLineBrush" Color="#D9A441" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#7A8794" />
</ResourceDictionary>
