<Window x:Class="BatteryRescueAlert.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:BatteryRescueAlert.Core.ViewModels;assembly=BatteryRescueAlert.Core"
        Title="Battery Rescue Alert"
        Width="560" Height="760" MinWidth="460" MinHeight="560"
        WindowStartupLocation="Manual"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        AutomationProperties.Name="Battery Rescue Alert">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== Header + navigation ===== -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"
                Padding="24,16,24,0">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Image Source="Assets/app-logo-64.png" Width="32" Height="32" Margin="0,0,12,0"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Battery Rescue Alert" Style="{StaticResource AppTitle}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="-12,12,0,0"
                            KeyboardNavigation.TabNavigation="Local"
                            AutomationProperties.Name="Sections">
                    <RadioButton x:Name="NavDashboard" Content="Dashboard" GroupName="Nav" IsChecked="True"
                                 Style="{StaticResource NavTab}" Checked="Nav_Checked" Tag="0"
                                 AutomationProperties.Name="Dashboard" />
                    <RadioButton x:Name="NavSettings" Content="Settings" GroupName="Nav"
                                 Style="{StaticResource NavTab}" Checked="Nav_Checked" Tag="1"
                                 AutomationProperties.Name="Settings" />
                    <RadioButton x:Name="NavAbout" Content="About" GroupName="Nav"
                                 Style="{StaticResource NavTab}" Checked="Nav_Checked" Tag="2"
                                 AutomationProperties.Name="About" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ===== Pages ===== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
            <Grid Margin="24">

                <!-- Dashboard page -->
                <StackPanel x:Name="PageDashboard">
                    <ItemsControl ItemsSource="{Binding Notices}" Focusable="False" IsTabStop="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Notice}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚠" FontFamily="{StaticResource SymbolFont}" FontSize="16"
                                                   Foreground="{DynamicResource TextBrush}" Margin="0,0,10,0"
                                                   VerticalAlignment="Top" />
                                        <TextBlock Text="{Binding}" Style="{StaticResource BodyText}" MaxWidth="440" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Battery status" Style="{StaticResource SecondaryText}"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding PercentText}" Style="{StaticResource PercentDisplay}"
                                       AutomationProperties.Name="Battery percentage"
                                       AutomationProperties.LiveSetting="Polite" />
                            <ProgressBar Value="{Binding PercentValue, Mode=OneWay}" Style="{StaticResource BatteryBar}"
                                         Margin="16,4,16,16"
                                         AutomationProperties.Name="Battery level" />
                            <Border Style="{StaticResource Pill}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding PowerStateGlyph}" FontFamily="{StaticResource SymbolFont}"
                                               Margin="0,0,8,0" Foreground="{DynamicResource TextBrush}" />
                                    <TextBlock Text="{Binding PowerStateText}" Style="{StaticResource BodyText}"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Rectangle Height="1" Fill="{DynamicResource LineBrush}" Margin="0,20,0,20" />
                            <TextBlock Text="{Binding Headline}" Style="{StaticResource StatusText}"
                                       AutomationProperties.LiveSetting="Polite" />
                            <TextBlock Text="{Binding ActionText}" Style="{StaticResource BodyText}"
                                       TextAlignment="Center" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Warning thresholds" Style="{StaticResource SectionHeading}" />
                    <Border Style="{StaticResource Card}" Padding="16,8">
                        <ItemsControl ItemsSource="{Binding ThresholdRows}" Focusable="False" IsTabStop="False"
                                      AutomationProperties.Name="Warning thresholds">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ThresholdRowViewModel}">
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="64" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding PercentText}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" />
                                        <TextBlock Grid.Column="2" Text="{Binding StateText}"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <TextBlock Text="{Binding LastAlertText}" Style="{StaticResource SecondaryText}"
                               Visibility="{Binding HasLastAlert, Converter={StaticResource BoolToVisibility}}"
                               Margin="0,0,0,16" />

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Test Notification" Style="{StaticResource PrimaryButton}"
                                Command="{Binding TestCommand}" Margin="0,0,12,0"
                                AutomationProperties.HelpText="Shows a sample warning so you can check that notifications work." />
                        <Button Content="{Binding PauseButtonText}" Command="{Binding TogglePauseCommand}" />
                    </StackPanel>
                    <TextBlock Text="{Binding TestStatus}" Style="{StaticResource SecondaryText}" Margin="0,12,0,0"
                               Visibility="{Binding HasTestStatus, Converter={StaticResource BoolToVisibility}}"
                               AutomationProperties.LiveSetting="Polite" />
                </StackPanel>

                <!-- Settings page -->
                <StackPanel x:Name="PageSettings" Visibility="Collapsed">
                    <TextBlock Text="Battery Alerts" Style="{StaticResource SectionHeading}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox Content="Enable battery alerts" Style="{StaticResource ToggleSwitch}"
                                      IsChecked="{Binding AlertsEnabled}" />
                            <TextBlock Style="{StaticResource SecondaryText}" Margin="54,0,0,12"
                                       Text="Alerts when Windows reports the battery at or below your selected threshold. Each threshold must be lower than the one above it." />

                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" Content="Warning 1" Style="{StaticResource ToggleSwitch}"
                                          IsChecked="{Binding Warning1Enabled}" />
                                <TextBox Grid.Column="1" Style="{StaticResource NumberBox}"
                                         Text="{Binding Warning1Text, UpdateSourceTrigger=PropertyChanged}"
                                         PreviewTextInput="Number_PreviewTextInput"
                                         AutomationProperties.Name="Warning 1 percentage" />
                                <TextBlock Grid.Column="2" Text="%" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </Grid>
                            <TextBlock Text="{Binding Warning1Error, StringFormat='⚠ {0}'}" Style="{StaticResource ErrorText}"
                                       Visibility="{Binding HasWarning1Error, Converter={StaticResource BoolToVisibility}}" />

                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" Content="Warning 2" Style="{StaticResource ToggleSwitch}"
                                          IsChecked="{Binding Warning2Enabled}" />
                                <TextBox Grid.Column="1" Style="{StaticResource NumberBox}"
                                         Text="{Binding Warning2Text, UpdateSourceTrigger=PropertyChanged}"
                                         PreviewTextInput="Number_PreviewTextInput"
                                         AutomationProperties.Name="Warning 2 percentage" />
                                <TextBlock Grid.Column="2" Text="%" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </Grid>
                            <TextBlock Text="{Binding Warning2Error, StringFormat='⚠ {0}'}" Style="{StaticResource ErrorText}"
                                       Visibility="{Binding HasWarning2Error, Converter={StaticResource BoolToVisibility}}" />

                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" Content="Critical" Style="{StaticResource ToggleSwitch}"
                                          IsChecked="{Binding CriticalEnabled}" />
                                <TextBox Grid.Column="1" Style="{StaticResource NumberBox}"
                                         Text="{Binding CriticalText, UpdateSourceTrigger=PropertyChanged}"
                                         PreviewTextInput="Number_PreviewTextInput"
                                         AutomationProperties.Name="Critical percentage" />
                                <TextBlock Grid.Column="2" Text="%" VerticalAlignment="Center" Margin="6,0,0,0" />
                            </Grid>
                            <TextBlock Text="{Binding CriticalError, StringFormat='⚠ {0}'}" Style="{StaticResource ErrorText}"
                                       Visibility="{Binding HasCriticalError, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Startup" Style="{StaticResource SectionHeading}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox Content="Start Battery Rescue Alert with Windows" Style="{StaticResource ToggleSwitch}"
                                      IsChecked="{Binding StartWithWindows}" />
                            <TextBlock Text="{Binding StartupNote}" Style="{StaticResource SecondaryText}" Margin="54,0,0,0"
                                       Visibility="{Binding HasStartupNote, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Notifications" Style="{StaticResource SectionHeading}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <CheckBox Content="Show notifications" Style="{StaticResource ToggleSwitch}"
                                      IsChecked="{Binding NotificationsEnabled}" />
                            <TextBlock Style="{StaticResource SecondaryText}" Margin="54,0,0,0"
                                       Text="Battery Rescue Alert displays its own on-screen popup. Windows notification settings and Focus or Do Not Disturb do not control this popup." />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Alert sound" Style="{StaticResource SectionHeading}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource BodyText}"
                                       Text="Choose the sound used for the Test Notification and real battery alerts. Windows notification sound is selected by default." />
                            <ComboBox Margin="0,12,0,10" MinHeight="36" Padding="8,4"
                                      Background="{DynamicResource SurfaceBrush}"
                                      Foreground="{DynamicResource TextBrush}"
                                      BorderBrush="{DynamicResource LineBrush}"
                                      ItemsSource="{Binding NotificationSoundOptions}"
                                      DisplayMemberPath="Name" SelectedValuePath="Id"
                                      SelectedValue="{Binding NotificationSoundId, UpdateSourceTrigger=PropertyChanged}"
                                      AutomationProperties.Name="Notification sound" />
                            <WrapPanel>
                                <Button Content="Preview sound" Command="{Binding PreviewSoundCommand}" Margin="0,0,8,8" />
                                <Button Content="Add custom tone..." Command="{Binding AddCustomToneCommand}" Margin="0,0,8,8" />
                                <Button Content="Delete selected custom tone" Command="{Binding DeleteCustomToneCommand}" Margin="0,0,0,8" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource SecondaryText}"
                                       Text="Custom tones are copied into %APPDATA%\BatteryRescueAlert\CustomTones, so deleting the original file does not break an alert. Supported formats: WAV, MP3, WMA, M4A, AAC and FLAC. Files must be 20 MB or smaller. Custom audio plays for up to 5 seconds per alert. Save changes to apply a new selection." />
                            <TextBlock Text="{Binding ToneStatus}" Style="{StaticResource SecondaryText}" Margin="0,10,0,0"
                                       Visibility="{Binding HasToneStatus, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Testing" Style="{StaticResource SectionHeading}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Button Content="Test Notification" Command="{Binding TestCommand}" HorizontalAlignment="Left" />
                            <TextBlock Text="{Binding TestStatus}" Style="{StaticResource SecondaryText}" Margin="0,12,0,0"
                                       Visibility="{Binding HasTestStatus, Converter={StaticResource BoolToVisibility}}" />
                            <Rectangle Height="1" Fill="{DynamicResource LineBrush}" Margin="0,16" />
                            <CheckBox Content="Write a small diagnostic log" Style="{StaticResource ToggleSwitch}"
                                      IsChecked="{Binding DiagnosticLogging}" />
                            <TextBlock Style="{StaticResource SecondaryText}" Margin="54,0,0,0"
                                       Text="Stored only on this PC (about 0.5 MB maximum). It never contains personal information." />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- About page -->
                <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Battery Rescue Alert" Style="{StaticResource AppTitle}" />
                            <TextBlock Text="{Binding VersionText, StringFormat='Version {0}'}"
                                       Style="{StaticResource SecondaryText}" Margin="0,2,0,12" />
                            <TextBlock Style="{StaticResource BodyText}"
                                       Text="Get an early warning before your laptop battery becomes critical. Battery Rescue Alert shows a notification when Windows reports the battery at or below the thresholds you choose." />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Privacy" Style="{StaticResource SectionHeading}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource BodyText}"
                                       Text="Everything stays on your PC. There is no account, no internet connection, no telemetry, and no tracking. Your settings are stored in:" />
                            <TextBlock Text="{Binding DataFolderText}" Style="{StaticResource SecondaryText}" Margin="0,8,0,0"
                                       FontFamily="Consolas" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Good to know" Style="{StaticResource SectionHeading}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,8"
                                       Text="• It only warns you. It never closes programs, changes power settings or shuts anything down." />
                            <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,8"
                                       Text="• It relies on the battery information that Windows and your hardware report. The percentage may not change at every 1%." />
                            <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,8"
                                       Text="• Battery warnings use an app-owned popup and do not depend on Windows Notification Center." />
                            <TextBlock Style="{StaticResource BodyText}"
                                       Text="• It cannot stop a laptop from shutting down if the battery runs out." />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="License" Style="{StaticResource SectionHeading}" />
                    <Border Style="{StaticResource Card}">
                        <TextBlock Style="{StaticResource BodyText}"
                                   Text="Open source under the MIT License. Built with .NET 8 and Windows Presentation Foundation (both MIT licensed). The icon is original artwork released under the same license. Full texts are in the LICENSE and THIRD-PARTY-NOTICES files." />
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- ===== Save bar (Settings page only) ===== -->
        <Border x:Name="SaveBar" Grid.Row="2" Visibility="Collapsed"
                Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,1,0,0" Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" Style="{StaticResource SecondaryText}"
                           Text="{Binding SaveStatus}" Margin="0,0,12,0"
                           AutomationProperties.LiveSetting="Polite" />
                <Button Grid.Column="1" Content="Revert" Command="{Binding RevertCommand}" Margin="0,0,8,0" />
                <Button Grid.Column="2" Content="Save changes" Style="{StaticResource PrimaryButton}"
                        Command="{Binding SaveCommand}" />
            </Grid>
        </Border>
    </Grid>
</Window>
